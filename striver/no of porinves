class Solution{
public:

void dfs(int node, vecotr<vector<int>> &adj, vector<int>& vis)
{
    vis[node]=1;
     for (int j = 0; j < adj.size(); j++) {
            if (adj[node][j] == 1 && !vis[j]) {
                dfs(j, adj, vis);
            }
        }
}    int numProvinces(vector<vector<int>> adj) {
       int n = adj.size();
        vector<int> vis(n, 0);
        int count = 0;

        for (int i = 0; i < n; i++) {
            if (!vis[i]) {
                count++;
                dfs(i, adj, vis);
            }
        }
        return count;
    }
};
