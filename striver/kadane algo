class Solution {
public:
    int maxSubArray(vector<int>& nums) {
          int currSum = nums[0];
        int maxSum = nums[0];
        for(int i=1;i< nums.size();i++){
            currSum = max(nums[i], currSum + nums[i]);
            maxSum = max(maxSum,currSum);
        }
        return maxSum;
    }
};

EX : 2,3,5,-2,7,-4
15
The subarray from index 0 to index 4 has the largest sum = 15