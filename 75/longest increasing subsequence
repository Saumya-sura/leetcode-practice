class Solution {
public:
    int lengthOfLIS(vector<int>& nums) {
        vector<int> l;
        for(int n: nums){
            auto it = lower_bound(l.begin(),l.end(),n);
            if( it == l.end()){
                l.push_back(n);
            }else{
            *it=n;
        }}
        return l.size();
    }
};