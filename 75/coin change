class Solution {
public:
    int coinChange(vector<int>& coins, int amount) {
        // 1. Create a DP table of size amount + 1. 
        // 2. Initialize with (amount + 1) because the max coins needed 
        //    could never exceed the amount itself (even with all 1-cent coins).
        vector<int> dp(amount + 1, amount + 1);

        // 3. Base case: To make an amount of 0, you need 0 coins.
        dp[0] = 0;

        // 4. Outer loop: Calculate the minimum coins for every value from 1 to 'amount'.
        for (int i = 1; i <= amount; i++) {
            
            // 5. Inner loop: Try every available coin denomination for the current value 'i'.
            for (int coin : coins) {
                
                // 6. Check if the coin is actually usable (can't use a 5-cent coin for 3 cents).
                if (i - coin >= 0) {
                    
                    // 7. Core DP Transition:
                    // dp[i] is the current best known way to make amount 'i'.
                    // dp[i - coin] + 1 is the way to make the remainder after using this 'coin'.
                    // We take the minimum of these two.
                    dp[i] = min(dp[i], dp[i - coin] + 1);
                }
            }
        }

        // 8. If the value at dp[amount] is still (amount + 1), it means it's unreachable.
        // Return -1 if unreachable, otherwise return the calculated minimum.
        return dp[amount] > amount ? -1 : dp[amount];
    }
};