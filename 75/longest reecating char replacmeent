class Solution {
public:
    int characterReplacement(string s, int k) {
        vector<int> count(26, 0); // Frequency map for characters A-Z
        int maxCount = 0;         // Count of the most frequent character in the current window
        int i = 0;                // Left pointer of the window
        int maxLength = 0;        // Result

        // j is the Right pointer of the window
        for (int j = 0; j < s.length(); j++) {
            // 1. Expand the window by including s[j]
            count[s[j] - 'A']++;
            
            // 2. Update the count of the most frequent character seen in the current window
            maxCount = max(maxCount, count[s[j] - 'A']);
            
            // 3. Check if the window is valid.
            // Window length = j - i + 1
            // Number of replacements needed = (Window length) - maxCount
            // If replacements needed > k, the window is invalid and must shrink.
            if ((j - i + 1) - maxCount > k) {
                count[s[i] - 'A']--; // Remove the character at the left pointer
                i++;                 // Move the left pointer forward
            }
            
            // 4. Update the maximum length found so far
            // Note: Since we only shrink by 1 (using 'if' instead of 'while'), 
            // the window size never decreases, it only grows or shifts.
            maxLength = max(maxLength, j - i + 1);
        }
        
        return maxLength;
    }
};