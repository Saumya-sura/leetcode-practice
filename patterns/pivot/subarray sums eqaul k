class Solution {
public:
    int subarraySum(vector<int>& nums, int k) {
       map<int,int> pref;
        int cs =0,c=0;
        pref [0] =1;
        for(int n:nums){
            cs+=n;
            if(pref.find(cs-k) != pref.end() ){
                c+=pref[cs-k];
            }
            pref[cs]++;
        }
        return c;
    }
};